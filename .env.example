VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Next.js AI BFF. The Gemini key remains server-only in the customer app.
# Development defaults to http://127.0.0.1:3000 when this is omitted.
VITE_AI_BFF_URL=http://127.0.0.1:3000
# Set this frontend's exact origin as AI_ADMIN_ORIGIN in the BFF environment.
# Feedback signing/model/service-role secrets belong only in the BFF.

# Production deployment notes:
# - set VITE_AI_BFF_URL to the real Guest/BFF HTTPS origin;
# - every VITE_ value is public browser configuration;
# - never put Supabase secret/service-role, model, signing, Cron, or account
#   credentials in this file or in any VITE_ variable.
# STAFF_PRODUCTION_URL is used only by `npm run smoke:production`; configure it
# in the operator shell/CI job, not in the built application environment.
